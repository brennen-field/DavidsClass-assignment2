# Copy this file to .env and fill in real values. Never commit .env.
# Get the class endpoint details from the team, not from this file.

CLASS_API_KEY=

# Class services at dobolyi.com (ports 9001+). Replace PORT with the real port for each service.
LLM_URL=https://dobolyi.com:PORT
TEXT_EMBED_URL=http://dobolyi.com:9002/v2/embed
TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
VISUAL_EMBED_URL=https://dobolyi.com:PORT
RERANK_URL=https://dobolyi.com:PORT
PARSE_URL=https://dobolyi.com:PORT

# Where uploaded documents, page images, and indexes are stored locally
DATA_DIR=data
