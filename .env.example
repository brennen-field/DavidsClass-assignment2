# Copy this file to .env and fill in real values (esp. CLASS_API_KEY). Never commit .env.
# Class endpoints for embeddings and reranking are pinned below; get any missing
# ports (LLM_URL, PARSE_URL) from the team.

CLASS_API_KEY=

# Class services at dobolyi.com (ports 9001+). Replace PORT with the real port for each service.
LLM_URL=https://dobolyi.com:PORT
TEXT_EMBED_URL=http://dobolyi.com:9002/v2/embed
TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
VISUAL_EMBED_URL=http://dobolyi.com:9003/v2/embed
VISUAL_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
RERANK_URL=http://dobolyi.com:9004/v2/rerank
RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
PARSE_URL=https://dobolyi.com:PORT

# Where uploaded documents, page images, and indexes are stored locally
DATA_DIR=data
